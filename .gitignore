# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# OS / editor
.DS_Store
.idea/
.vscode/

# Survey cache — regenerable via scripts/survey_papers.py, and it holds verbatim
# publisher abstracts, which don't belong in a public repo.
content/survey-cache.json

# Source PDFs used only to extract figures. Publisher PDFs must never be
# committed to a public repo — only the individual figures we have a licence or
# author-reuse right to republish end up in docs/papers/figures/.
pdfs/
*.pdf

# Secrets — never commit
*token*
*.secret
.env

# Scratch contact sheets from scripts/extract_figures.py
.figure-candidates/
