{% extends "_base.html.j2" %}
{% block title %}{{ paper.title }}{% endblock %}
{% block description %}{{ paper.description }}{% endblock %}
{% block content %}
    <section class="page-title page-title-long">
      <div class="eyebrow">What We Publish</div>
      <h1>{{ paper.title }}</h1>
      <p class="paper-meta"><a target="_blank" rel="noopener noreferrer" href="{{ paper.doi_url }}">{{ paper.author_line }} · {{ paper.journal }}{% if paper.volume %} {{ paper.volume }}{% endif %}{% if paper.pages %}, {{ paper.pages }}{% endif %} · {{ paper.year }}</a></p>
      <p class="key-finding"><strong>Key finding.</strong> {{ paper.key_finding }}</p>
    </section>

    <section class="section bio">
{% if paper.figure %}
{# Every figure links to its own file: the page shows it at column width, and a
   reader who needs to read the labels clicks through to full resolution. #}
      <figure class="paper-figure">
        <a class="figure-zoom" href="figures/{{ paper.figure.file }}"><img src="figures/{{ paper.figure.file }}" alt="{{ paper.figure.alt }}" loading="lazy"></a>
        <figcaption>
          {{ paper.figure.caption }}
          <span class="credit">{{ paper.figure.credit_line }}</span>
        </figcaption>
      </figure>
{% endif %}

      <h2>What question did this research address?</h2>
{% for para in paper.question %}
      <p>{{ para }}</p>
{% endfor %}

      <h2>What did we find?</h2>
{% for para in paper.findings %}
      <p>{{ para }}</p>
{% endfor %}

      <h2>Why does it matter?</h2>
{% for para in paper.matters %}
      <p>{{ para }}</p>
{% endfor %}

{% if paper.additional %}
      <h2>Additional analysis</h2>
      <p class="analysis-label">Not reported in the published paper</p>
{% for para in paper.additional.paragraphs %}
      <p>{{ para }}</p>
{% endfor %}
{% for table in paper.additional.tables %}
      <div class="paper-table">
        <table>
          <caption>{{ table.caption }}</caption>
          <thead>
            <tr>{% for c in table.columns %}<th scope="col">{{ c }}</th>{% endfor %}</tr>
          </thead>
          <tbody>
{% for row in table.rows %}
            <tr><th scope="row">{{ row[0] }}</th>{% for c in row[1:] %}<td>{{ c }}</td>{% endfor %}</tr>
{% endfor %}
          </tbody>
        </table>
{% for note in table.notes %}
        <p class="table-note">{{ note }}</p>
{% endfor %}
      </div>
{% endfor %}
      <p class="analysis-source">{{ paper.additional.source }}{% if paper.additional.url %} <a target="_blank" rel="noopener noreferrer" href="{{ paper.additional.url }}">Code, data, and outputs on GitHub</a>.{% endif %}</p>

{% endif %}
      <h2>Citation</h2>
      <p>{{ paper.full_citation }}</p>
      <ul>
        <li><a target="_blank" rel="noopener noreferrer" href="{{ paper.doi_url }}">Published article (doi:{{ paper.doi }})</a></li>
{% for link in paper.links %}
        <li><a target="_blank" rel="noopener noreferrer" href="{{ link.url }}">{{ link.label }}</a></li>
{% endfor %}
      </ul>

{% if posts %}
      <h2>What we are thinking</h2>
      <ul>
{% for post in posts %}
        <li><a href="../{{ post.url_path }}">{{ post.title }}</a> ({{ post.byline }}, {{ post.display_date }})</li>
{% endfor %}
      </ul>
{% endif %}
{% if themes or related %}
      <h2>Related</h2>
      <ul>
{% for theme in themes %}
        <li><a href="../{{ theme.url_path }}">{{ theme.question }}</a></li>
{% endfor %}
{% for rel in related %}
        <li><a href="{{ rel.id }}.html">{{ rel.title }}</a> ({{ rel.short_citation }})</li>
{% endfor %}
      </ul>
{% endif %}
    </section>
{% endblock %}
