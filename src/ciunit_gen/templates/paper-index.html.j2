{% extends "_base.html.j2" %}
{% block title %}What We Publish{% endblock %}
{% block description %}Plain-language summaries of peer-reviewed publications by researchers of the Conceptual Investigations Unit — each with its key finding, a key figure, and a link to the published article.{% endblock %}
{% block content %}
    <section class="page-title">
      <div class="eyebrow">What We Publish</div>
      <h1>What We Publish</h1>
      <p class="lede">
        What questions did we try to answer? What did we find? And why does it matter?
      </p>
      <p class="pub-themes">
{%- for theme in themes %}
        <a href="{{ theme.url_path }}">{{ theme.title }}</a>{% if not loop.last %} · {% endif %}
{%- endfor %}
      </p>
    </section>

    <p class="pub-scope">Selected publications</p>

    <form class="pub-filter" role="search" data-pub-filter hidden>
      <label for="pub-search">Search these publications</label>
      <input type="search" id="pub-search" name="q" autocomplete="off"
        placeholder="title, author, journal, or year">
    </form>
    <p class="pub-status" role="status" data-pub-status></p>

    <ul class="pub-grid">
{% for paper in papers %}
      <li class="pub-item" data-search="{{ paper.search_text }}">
        <a class="pub-card card-link" href="{{ paper.url_path }}">
{% if paper.thumbnail %}
          <img class="pub-cover" src="publications/covers/{{ paper.thumbnail.file }}"
            alt="" width="400" height="533" decoding="async"
            loading="{{ 'eager' if loop.index <= 6 else 'lazy' }}">
{% else %}
          <span class="pub-cover pub-cover-blank" aria-hidden="true">
            <span class="pub-cover-journal">{{ paper.journal }}</span>
            <span class="pub-cover-title">{{ paper.title }}</span>
            <span class="pub-cover-cite">{{ paper.short_citation }}</span>
          </span>
{% endif %}
          <span class="pub-card-body">
            <h3>{{ paper.title }}</h3>
            <p class="paper-meta">{{ paper.short_citation }} · {{ paper.journal }}</p>
          </span>
        </a>
      </li>
{% endfor %}
    </ul>

    <p class="pub-empty" data-pub-empty hidden>No publications match that search.</p>
{% if cover_bases %}
    <p class="pub-credit">
      Cover images are the first page of each published article, reproduced under
      {{ cover_bases | join(' and ') }}.
    </p>
{% endif %}
    <script src="js/publications.js" defer></script>
{% endblock %}
